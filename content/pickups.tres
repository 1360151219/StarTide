[sub_resource type="Resource" id="Bomb"]
script = ExtResource("2_entry")
content_id = "star_bomb"
data = {
"accent": Color(1, 0.54902, 0.298039, 1),
"amount": 35.0,
"description": "拾取后对 180 范围内的怪物造成 35 点伤害；第三关首次出现。",
