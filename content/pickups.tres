"duration": 5.0,
"effect": "magnet",
"name": "星引护符",
"radius": 13.0,
"size": Vector2(37.9, 50),
"subtitle": "功能道具",
"texture": ExtResource("5_magnet")
}

[sub_resource type="Resource" id="Haste"]
script = ExtResource("2_entry")
content_id = "haste_leaf"
data = {
