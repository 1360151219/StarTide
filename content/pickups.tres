}

[resource]
script = ExtResource("1_manifest")
catalog_id = "pickups"
entries = Array[ExtResource("2_entry")]([SubResource("Xp"), SubResource("Heart"), SubResource("Magnet"), SubResource("Haste"), SubResource("Bomb")])
