[gd_resource type="Resource" script_class="ContentManifestConfig" format=3]

[ext_resource type="Script" path="res://scripts/content/content_manifest_config.gd" id="1_manifest"]
[ext_resource type="Script" path="res://scripts/content/content_entry_config.gd" id="2_entry"]
[ext_resource type="Texture2D" path="res://assets/art/pickups/experience_shard.png" id="3_xp"]
[ext_resource type="Texture2D" path="res://assets/art/pickups/healing_heart.png" id="4_heart"]
[ext_resource type="Texture2D" path="res://assets/art/pickups/magnet_charm.png" id="5_magnet"]
[ext_resource type="Texture2D" path="res://assets/art/items/item_atlas.png" id="6_atlas"]

[sub_resource type="AtlasTexture" id="HasteTexture"]
atlas = ExtResource("6_atlas")
region = Rect2(768, 512, 384, 512)
filter_clip = true

[sub_resource type="AtlasTexture" id="BombTexture"]
atlas = ExtResource("6_atlas")
region = Rect2(1152, 512, 384, 512)
filter_clip = true

[sub_resource type="Resource" id="Xp"]
script = ExtResource("2_entry")
content_id = "xp"
data = {
"accent": Color(0.439216, 0.909804, 1, 1),
"amount": 0.0,
"description": "怪物被击败后掉落，积满经验即可获得三选一强化。",
"duration": 0.0,
"effect": "experience",
"name": "星辉碎片",
"radius": 8.0,
"size": Vector2(30, 32),
"subtitle": "经验道具",
"texture": ExtResource("3_xp")
}

[sub_resource type="Resource" id="Heart"]
script = ExtResource("2_entry")
content_id = "heart"
data = {
