[sub_resource type="Resource" id="StarLance"]
script = ExtResource("2_entry")
content_id = "star_lance"
data = {
"branch_level": 2,
"branches": {
"star_lance_fan": {
"description": "增加弹体与扇面宽度，强化群体覆盖。",
"level_overrides": {
2: {"count": 3, "damage_multiplier": 0.78, "spread": 0.18},
3: {"count": 4, "damage_multiplier": 0.74, "spread": 0.22}
},
"name": "星雨齐射",
"visual_tags": ["多弹", "广域"]
},
"star_lance_pierce": {
"description": "减少散射，换取更高伤害与贯穿能力。",
"level_overrides": {
2: {"count": 1, "damage_multiplier": 1.35, "pierce": 1},
3: {"count": 1, "damage_multiplier": 1.45, "pierce": 1}
},
"name": "贯星长枪",
"visual_tags": ["高伤", "贯穿"]
}
},
"descriptions": ["", "自动锁定最近的敌人发射星枪", "同时发射两枚，伤害与频率提升", "三枚高速星枪形成密集星芒扇面"],
"icon": ExtResource("3_star_lance"),
"is_signature": true,
"max_level": 3,
"name": "星芒枪",
"owner_hero_id": "star_warden",
"runtime": {
"cooldown": [0.0, 0.92, 0.9, 0.88],
"count": [0, 1, 2, 3],
"damage": [0.0, 22.0, 27.0, 31.0],
"pierce": [0, 0, 0, 0],
"radius": [0.0, 7.0, 7.0, 9.0],
"speed": [0.0, 520.0, 560.0, 610.0],
"spread": [0.0, 0.13, 0.13, 0.19]
},
"runtime_key": "star_lance",
"ultimate_name": "星陨万华"
}

