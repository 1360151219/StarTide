[gd_resource type="Resource" script_class="ContentManifestConfig" format=3]

[ext_resource type="Script" path="res://scripts/content/content_manifest_config.gd" id="1_manifest"]
[ext_resource type="Script" path="res://scripts/content/content_entry_config.gd" id="2_entry"]
[ext_resource type="Texture2D" path="res://assets/art/items/item_atlas.png" id="3_atlas"]

[sub_resource type="AtlasTexture" id="StarCoreIcon"]
atlas = ExtResource("3_atlas")
region = Rect2(0, 0, 384, 512)
filter_clip = true

[sub_resource type="AtlasTexture" id="FlowFeatherIcon"]
atlas = ExtResource("3_atlas")
region = Rect2(384, 0, 384, 512)
