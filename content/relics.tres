region = Rect2(0, 512, 384, 512)
filter_clip = true

[sub_resource type="AtlasTexture" id="StarBellIcon"]
atlas = ExtResource("3_atlas")
region = Rect2(384, 512, 384, 512)
filter_clip = true

[sub_resource type="Resource" id="StarCore"]
script = ExtResource("2_entry")
content_id = "star_core"
data = {
"acquire_effects": {"heal": 15.0},
"description": "最大生命 +15；获得时恢复 15 点生命。",
"icon": SubResource("StarCoreIcon"),
"max_level": 3,
"modifiers_per_level": {"max_health_flat": 15.0},
"name": "星核扩容"
}

